<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FEE9E1"
            android:elevation="4dp"
            android:textColor="@color/black"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <!-- Search Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FEE9E1"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search Courses"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Search Input Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/search_input_background"
                android:padding="4dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/search_twotones_icon"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Search Icon" />

                <EditText
                    android:id="@+id/search_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Search for courses..."
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins"
                    android:background="@null"
                    android:padding="12dp"
                    android:textColor="@color/black"
                    android:textColorHint="#757575"
                    android:inputType="text"
                    android:imeOptions="actionSearch" />

                <Button
                    android:id="@+id/search_button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Search"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    android:background="@drawable/search_button_background"
                    android:textColor="@color/white"
                    android:layout_marginEnd="4dp"
                    android:minWidth="80dp" />
            </LinearLayout>

            <!-- Search Tips -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Try searching by course name or subject"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:alpha="0.8" />
        </LinearLayout>

        <!-- Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Results Header -->
                <TextView
                    android:id="@+id/resultsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Search Results"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <!-- No Results Message -->
                <LinearLayout
                    android:id="@+id/noResultsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/search_twotones_icon"
                        android:contentDescription="Search Icon"
                        android:alpha="0.3"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No courses found"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Try searching with different keywords"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:fontFamily="@font/poppins"
                        android:gravity="center" />
                </LinearLayout>

                <!-- RecyclerView for Courses -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/coursesRecyclerViewSearchedCourses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:clipToPadding="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="8dp"
            app:menu="@menu/bottom_navigation_bar"
            app:itemIconTint="@color/black"
            app:itemTextColor="@color/black" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
